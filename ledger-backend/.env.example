PORT=3002
CREDITS_PER_SECOND=2
LIVE_SECONDS_PER_500_CREDITS=180
FRONTEND_URL=http://localhost:5173

# Flutterwave — https://dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# NGN enables bank transfer / USSD. Use USD only if you do not need bank transfer.
FLUTTERWAVE_CURRENCY=NGN
# Used when converting USD receipts to NGN for ledger records
NAIRA_PER_USD=1600

# Admin panel at /admin.html
ADMIN_SECRET=

# Decart master key (dct_...) — mints short-lived ek_ tokens for live video
DECART_API_KEY=

# ElevenLabs — chunk voice changer
ELEVENLABS_API_KEY=

# Real-time voice (RunPod voice-rt-server) — must match pod env
RTC_TICKET_SECRET=
VOICE_RT_URL=
